# PostgreSQL en la nube (Neon / Supabase). Copia este archivo a .env y pega tu cadena.
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"
# Neon/Supabase: conexion DIRECTA (sin pooler) para migraciones y seed.
DIRECT_URL="postgresql://usuario:clave@host-directo/basedatos?sslmode=require"

JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

PORT=3000
CORS_ORIGIN="http://localhost:4200,http://localhost:4300"
UPLOADS_DIR="uploads"
PUBLIC_URL="http://localhost:3000"

# Fotos de producto en Cloudinary. Con las tres variables puestas, las subidas
# van alli y sobreviven a los despliegues; sin ellas caen al disco local
# (comodo en desarrollo, pero en Render el disco se borra en cada reinicio).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
