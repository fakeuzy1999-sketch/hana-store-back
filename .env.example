# PostgreSQL en la nube (Neon / Supabase). Copia este archivo a .env y pega tu cadena.
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"

JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

PORT=3000
CORS_ORIGIN="http://localhost:4200"
UPLOADS_DIR="uploads"
PUBLIC_URL="http://localhost:3000"
